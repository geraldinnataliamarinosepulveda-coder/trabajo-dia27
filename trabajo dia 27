"""
Caso. Cree las funciones necesarias para costo de envío con cobertura y descuento. Es un modelo
ficticio. La tarifa base es 5000 pesos en zona 1 y 8000 en zona 2; cada kilogramo por encima del
primero agrega 2000 pesos proporcionales, sin redondear el peso. Una compra de al menos 100000
pesos reduce el costo válido un 50 %. Cree funciones de cobertura lógica, costo inicial y costo final.
La última reutiliza las otras y nunca descuenta la señal -1. El escenario muestra el retorno o «sin
cobertura». Contratos en orden de parámetros: Cobertura: recibe peso real en kg y zona entera y
devuelve lógico. Costo inicial: recibe peso real mayor que cero y hasta 20 kg, zona 1 o 2 y devuelve
real positivo en pesos. Costo final: recibe peso real en kg, zona entera, compra real no negativa en
pesos y devuelve real no negativo en pesos o - 1.
Fórmula o relación: Base según zona; recargo = 2000 * máximo entre (peso - 1) y 0; costo inicial
= base + recargo; costo final = costo inicial * 0,50 si compra ≥ 100000, o costo inicial en otro
caso.

"""
def cobertura(peso, zona):
    """Verifica si el envío tiene cobertura."""
    return 0 < peso <= 20 and type(zona) is int and zona in (1, 2)


def costo_inicial(peso, zona):
    """Calcula el costo base más el recargo por peso."""
    if zona == 1:
        base = 5000
    else:
        base = 8000

    recargo = 2000 * max(peso - 1, 0)

    return base + recargo


def costo_final(peso, zona, compra):
    """Calcula el costo final del envío."""
    if not cobertura(peso, zona):
        return -1

    costo = costo_inicial(peso, zona)

    if compra >= 100000:
        costo = costo * 0.50

    return costo


def escenario(peso, zona, compra):
    resultado = costo_final(peso, zona, compra)

    if resultado == -1:
        print("Sin cobertura")
    else:
        print("El costo final del envío es:", resultado, "pesos")


