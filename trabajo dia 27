def cupos_libres(capacidad: int, ocupacion: int) -> int:
    """Devuelve los cupos libres; la ocupación debe estar entre 0 y capacidad."""
    if not isinstance(capacidad, int) or isinstance(capacidad, bool) or capacidad < 0:
        raise ValueError("La capacidad debe ser un entero no negativo.")
    if not isinstance(ocupacion, int) or isinstance(ocupacion, bool):
        raise ValueError("La ocupación debe ser un entero.")
    if not 0 <= ocupacion <= capacidad:
        raise ValueError("La ocupación debe estar entre 0 y la capacidad.")
    return capacidad - ocupacion


def elegir_sala(
    capacidad1: int,
    ocupacion1: int,
    capacidad2: int,
    ocupacion2: int,
    grupo: int,
) -> int:
    """Devuelve 1 o 2 para la sala elegida, o 0 si el grupo no cabe."""
    libres1 = cupos_libres(capacidad1, ocupacion1)
    libres2 = cupos_libres(capacidad2, ocupacion2)
    if not isinstance(grupo, int) or isinstance(grupo, bool) or grupo <= 0:
        raise ValueError("El grupo debe ser un entero positivo.")

    elegibles = []
    if libres1 >= grupo:
        elegibles.append((libres1 - grupo, 1))
    if libres2 >= grupo:
        elegibles.append((libres2 - grupo, 2))
    return min(elegibles)[1] if elegibles else 0


def main() -> None:
    capacidad1 = int(input("Ingrese la capacidad de la sala 1: "))
    ocupacion1 = int(input("Ingrese la ocupación de la sala 1: "))
    capacidad2 = int(input("Ingrese la capacidad de la sala 2: "))
    ocupacion2 = int(input("Ingrese la ocupación de la sala 2: "))
    grupo = int(input("Ingrese la cantidad de personas del grupo: "))

    sala = elegir_sala(capacidad1, ocupacion1, capacidad2, ocupacion2, grupo)
    if sala == 0:
        print("No hay una sala disponible para todo el grupo")
    else:
        print(f"La sala elegida es: {sala}")


if __name__ == "__main__":
    main()
