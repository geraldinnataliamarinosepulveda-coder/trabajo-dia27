"""
Cree una función para año bisiesto. Use el calendario gregoriano: los múltiplos de
100 no son bisiestos salvo que también sean múltiplos de 400. El escenario hace dos
llamadas y comprueba si ambos años comparten la misma condición de bisiesto:
verdadero cuando ambos retornos son iguales, falso cuando son diferentes. Contrato:
Año bisiesto: recibe un año entero entre 1 y 9999 y devuelve verdadero si el año es
bisiesto; falso en otro caso.
"""


def año_bisiesto(anio):
    """Devuelve True si el año es bisiesto según el calendario gregoriano."""
    if anio < 1 or anio > 9999:
        raise ValueError("El año debe estar entre 1 y 9999")
    if anio % 400 == 0:
        return True
    if anio % 100 == 0:
        return False
    return anio % 4 == 0


anio1 = int(input("Escribe el primer año entre 1 y 9999: "))
anio2 = int(input("Escribe el segundo año entre 1 y 9999: "))

