"""
Cree las funciones necesarias para reposición con mínimo y capacidad máxima. Solo se repone
cuando existencias es menor que mínimo. Los pedidos son múltiplos enteros del lote y se busca el
menor pedido que alcance el mínimo sin superar la capacidad. La función de pedido reutiliza
necesidad y una función de lotes necesarios. El escenario distingue «no reponer», cantidad válida e
imposibilidad. Contratos en orden de parámetros: Necesidad: recibe existencias y mínimo enteros
no negativos y devuelve lógico. Lotes necesarios: recibe faltante entero positivo y lote entero
positivo y devuelve entero positivo. Pedido: recibe existencias, mínimo y capacidad enteros no
negativos, con existencias ≤ capacidad y mínimo ≤ capacidad, y lote entero positivo y devuelve
entero no negativo o - 1.
"""
def necesita_reponer(existencias, minimo):
    return existencias < minimo


def lotes_necesarios(faltante, lote):
    return (faltante + lote - 1) // lote


def pedido(existencias, minimo, capacidad, lote):
    if existencias < 0 or minimo < 0 or capacidad < 0:
        return -1

    if existencias > capacidad or minimo > capacidad or lote <= 0:
        return -1

    if existencias >= minimo:
        return 0

    faltante = minimo - existencias
    lotes = lotes_necesarios(faltante, lote)
    cantidad = lotes * lote

    if existencias + cantidad > capacidad:
        return -1

    return cantidad


