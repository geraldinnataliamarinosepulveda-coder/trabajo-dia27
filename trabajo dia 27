"""
Cree una función para número perfecto. Un divisor propio es un entero positivo
menor que n que lo divide sin residuo. Un número perfecto coincide con la suma de sus
divisores propios; 1 no tiene divisores propios. La revisión termina antes de n. Realice
dos llamadas y presente los retornos por separado. Contrato: Número perfecto: recibe
un entero n entre 1 y 10000 y devuelve verdadero si n es perfecto, falso en otro caso.
"""


class Suma:
    """Proporciona la comprobación de números perfectos."""

    def numero_perfecto(self, n: int) -> bool:
        """Devuelve True si n es igual a la suma de sus divisores propios."""
        if not isinstance(n, int) or isinstance(n, bool) or not 1 <= n <= 10000:
            raise ValueError("n debe ser un entero entre 1 y 10000")

        suma_divisores = sum(divisor for divisor in range(1, n) if n % divisor == 0)
        return suma_divisores == n


suma = Suma()
numero1 = int(input("Ingrese numero: "))
numero2 = int(input("Ingrese otro numero: "))

print(suma.numero_perfecto(numero1))
print(suma.numero_perfecto(numero2))



def es_abundante(numero):
    suma = 0

    for divisor in range(1, numero):
        if numero % divisor == 0:
            suma = suma + divisor

    return suma > numero

